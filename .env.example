# Copy to .env.local for `vercel dev`, or set these in Vercel > Project > Settings > Environment Variables.

# Password for the admin page at /#/admin (required)
ADMIN_PASSWORD=change-me

# Optional: separate key for signing the admin session cookie. If omitted it is derived from ADMIN_PASSWORD.
# ADMIN_SESSION_SECRET=

# Postgres connection string. Added automatically when you attach a Neon database in Vercel's Storage tab.
# Leave it unset locally and the API reads/writes public/recommendations.json and public/resume/ instead.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
